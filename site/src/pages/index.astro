---
// oxlint-disable import/default -- Vite's `?raw` imports have a default export the import resolver can't see.
import Button from '../components/landing/Button.astro';
import CodePanel from '../components/landing/CodePanel.astro';
import CodeTabs from '../components/landing/CodeTabs.astro';
import CompareTabs from '../components/landing/CompareTabs.astro';
import Dock from '../components/landing/Dock.astro';
import InlineMarkdown from '../components/landing/InlineMarkdown.astro';
import InstallChip from '../components/landing/InstallChip.astro';
import Section from '../components/landing/Section.astro';
import Header from '../components/lcars/Header.astro';
import NavButton from '../components/lcars/NavButton.astro';
import captainsLog from '../examples/captains-log.ts?raw';
import codeBorg from '../examples/code-borg.ts?raw';
import codeClock from '../examples/code-clock.ts?raw';
import codeHolodeck from '../examples/code-holodeck.ts?raw';
import codeMenu from '../examples/code-menu.ts?raw';
import howOverride from '../examples/how-override.ts?raw';
import withLogTest from '../examples/why/with/captains-log.test.ts?raw';
import withLog from '../examples/why/with/captains-log.ts?raw';
import { Content as WithNotes } from '../examples/why/with/notes.md';
import withStardate from '../examples/why/with/stardate.ts?raw';
import withoutLogTest from '../examples/why/without/captains-log.test.ts?raw';
import withoutLog from '../examples/why/without/captains-log.ts?raw';
import { Content as WithoutNotes } from '../examples/why/without/notes.md';
import Landing from '../layouts/Landing.astro';
import { stardate } from '../lib/stardate';
import { withBase } from '../lib/url';

const guide = withBase('/docs/getting-started/');
const api = withBase('/docs/reference/core/');
const github = 'https://github.com/texel/hypospray';

const benefits = [
  {
    hue: 'var(--frame)',
    title: "It's just functions",
    body: 'No decorators, and type inference is automatic. You can even use it with plain JavaScript projects.',
  },
  {
    hue: 'var(--why)',
    title: 'Override with confidence',
    body: `Pin the clock in a test, swap a service per environment, or customize the behavior of a 3rd party library. \n\nMoving or changing imported files won't silently break your tests.`,
  },
  {
    hue: 'var(--uses)',
    title: 'High tech features',
    body: 'Hypospray supports hierarchical injectors, and integrates with your favorite frameworks. \n\nIt has a small footprint and no runtime dependencies.',
  },
];

const steps = [
  {
    n: 1,
    hue: 'var(--frame)',
    title: 'Provide',
    body: 'Write a dependency as an ordinary function or class.',
    code: captainsLog,
    region: 'write',
  },
  {
    n: 2,
    hue: 'var(--why)',
    title: 'Consume',
    body: 'Ask for it with `inject()`. The type is automatically inferred.',
    code: captainsLog,
    region: 'inject',
  },
  {
    n: 3,
    hue: 'var(--uses)',
    title: 'Override',
    body: 'Provide a different value to any injector. Callers never know.',
    code: howOverride,
    region: 'override',
  },
];

const tabs = [
  {
    id: 'clock',
    label: 'CLOCK',
    caption: 'Pin the clock in a test by providing a fixed value.',
    file: 'captains-log.test.ts',
    code: codeClock,
    region: 'example',
  },
  {
    id: 'menu',
    label: 'MENU',
    caption: 'Give each context its own version of a dependency.',
    file: 'replicator.ts',
    code: codeMenu,
    region: 'example',
  },
  {
    id: 'holodeck',
    label: 'HOLODECK',
    caption: 'A child injector overrides its parent without affecting it.',
    file: 'holodeck.ts',
    code: codeHolodeck,
    region: 'example',
  },
  {
    id: 'borg',
    label: 'BORG',
    caption: 'extendProvider builds on the current value instead of replacing it.',
    file: 'cube.ts',
    code: codeBorg,
    region: 'example',
  },
];
---

<Landing
  title="Hypospray — painless dependency injection for TypeScript"
  description="Hypospray is a small dependency injection library for TypeScript and JavaScript, built around plain functions and classes."
>
  <Header slot="header" homeHref="#">
    <NavButton href="#why" section="why" hue="var(--why)" label="WHY" />
    <NavButton href="#how" section="how" hue="var(--how)" label="HOW" />
    <NavButton href="#uses" section="uses" hue="var(--uses)" label="USES" />
    <NavButton href={withBase('/docs/')} hue="var(--docs)" label="DOCS" />
  </Header>

  <div class="hdr-spacer">
    <div data-header-sentinel></div>
  </div>

  <Section id="hero" hue="var(--frame)" dim="var(--hero-dim)">
    <div class="hero">
      <div class="hero-copy">
        <h1>Painless dependency injection for TypeScript.</h1>
        <p class="lede">
          Hypospray makes configuration and mocking easy. All the benefits of dependency injection,
          without any of the annoying parts.
          <br />
          <br />
          Because DI isn't just for Enterprise software.
        </p>
      </div>
      <div class="hero-visual">
        <CodePanel file="captains-log.ts" code={captainsLog} region="hero" />
      </div>
      <div class="actions">
        <Button href={guide}>Get started</Button>
        <InstallChip command="npm i @hypospray/core" />
      </div>

      <div class="benefits">
        {benefits.map((b) => (
          <div>
            <h3 style={`color: ${b.hue}`}>{b.title}</h3>
            <p>
              <InlineMarkdown text={b.body} />
            </p>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <Section id="why" name="Why" hue="var(--why)" dim="var(--why-dim)">
    <h2>
      Config and mocking are a pain.
      <br />
      We can do better.
    </h2>
    <p class="lede wide">
      Your project uses a package manager, so why are you still hard-wiring depdendencies into your
      code?
    </p>
    <div class="why-compare">
      <CompareTabs
        label="With and without Hypospray"
        sides={[
          {
            id: 'why-without',
            key: 'without',
            label: 'Without Hypospray',
            hue: 'var(--frame)',
            dim: 'var(--hero-dim)',
            notes: WithoutNotes,
            files: [
              { name: 'captains-log.ts', code: withoutLog, region: 'code' },
              { name: 'captains-log.test.ts', code: withoutLogTest },
            ],
          },
          {
            id: 'why-with',
            key: 'with',
            label: 'With Hypospray',
            hue: 'var(--why)',
            dim: 'var(--why-dim)',
            notes: WithNotes,
            files: [
              { name: 'captains-log.ts', code: withLog },
              { name: 'stardate.ts', code: withStardate, region: 'code' },
              { name: 'captains-log.test.ts', code: withLogTest },
            ],
          },
        ]}
      />
    </div>
  </Section>

  <Section id="how" name="How" hue="var(--how)" dim="var(--how-dim)">
    <div class="steps">
      {steps.map((s) => (
        <div class="step">
          <h3>
            <span class="numeral" style={`color: ${s.hue}`}>
              {s.n}
            </span>{' '}
            {s.title}
          </h3>
          <p>
            <InlineMarkdown text={s.body} />
          </p>
          <CodePanel code={s.code} region={s.region} />
        </div>
      ))}
    </div>
  </Section>

  <Section id="uses" name="Uses" hue="var(--uses)" dim="var(--uses-dim)" last>
    <h2>More examples? Make it so.</h2>
    <CodeTabs tabs={tabs} />
    <div class="cta">
      <div>
        <p class="cta-title">Ready when you are.</p>
        <p>Read the guide, or go straight to the API.</p>
      </div>
      <div class="cta-actions">
        <Button href={guide}>Get started</Button>
        <Button href={api} variant="secondary" hue="var(--why)">
          API reference
        </Button>
        <Button href={github} variant="secondary" hue="var(--uses)">
          GitHub
        </Button>
      </div>
    </div>
    <footer class="footer">
      <span>MIT License</span>
      <span>© 2026 Leigh Caplan</span>
      <span>Stardate {stardate(new Date())}</span>
    </footer>
  </Section>

  <Dock slot="dock" />
</Landing>

<style is:global>
  .hdr-spacer {
    position: relative;
    height: 186px;
  }
  [data-header-sentinel] {
    position: absolute;
    top: 24px;
    width: 1px;
    height: 1px;
  }
  main section[id] {
    scroll-margin-top: 86px;
  }
  @media (min-width: 600px) and (max-width: 1049.98px) {
    .hdr-spacer {
      height: 92px;
    }
  }
  @media (max-width: 599.98px) {
    .hdr-spacer {
      height: 70px;
    }
    main section[id] {
      scroll-margin-top: 46px;
    }
    body {
      padding-bottom: 110px;
    }
  }
</style>

<style>
  h1,
  h2,
  h3,
  .cta-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    color: var(--text);
  }
  h1 {
    font-size: 64px;
    line-height: 1;
  }
  h2 {
    font-size: 44px;
    line-height: 1.05;
    margin-bottom: 20px;
  }
  h3 {
    font-size: 24px;
    line-height: 1.2;
    margin-bottom: 8px;
  }
  .lede {
    max-width: 36ch;
    margin: 24px 0 32px;
    font-size: 21px;
    line-height: 1.5;
  }
  .lede.wide {
    max-width: 60ch;
    margin-top: 0;
  }
  .lede code {
    font-family: var(--font-code);
    font-size: 0.85em;
    color: var(--docs);
  }
  p {
    font-size: 18px;
    line-height: 1.5;
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    grid-template-areas:
      'copy visual'
      'actions actions'
      'benefits benefits';
    gap: 40px 64px;
    align-items: start;
  }
  .hero-copy {
    grid-area: copy;
  }
  .hero .lede {
    margin-bottom: 0;
  }
  .hero-visual {
    grid-area: visual;
  }
  .actions {
    grid-area: actions;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }
  .why-compare {
    margin-bottom: 48px;
  }
  .benefits,
  .steps {
    display: grid;
    grid-area: benefits;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }
  .steps {
    gap: 28px;
  }
  .step h3 {
    font-size: 26px;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .numeral {
    font-weight: 700;
    font-size: 40px;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    margin-top: 96px;
  }
  .cta-title {
    font-size: 36px;
  }
  .cta p {
    margin: 4px 0 0;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .footer {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 48px;
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  @media (max-width: 1049.98px) {
    .hero {
      grid-template-areas: 'copy' 'visual' 'actions' 'benefits';
    }
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
    .benefits,
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 599.98px) {
    h1 {
      font-size: 44px;
    }
    h2 {
      font-size: 32px;
    }
  }
</style>
