---
import Button from '../components/landing/Button.astro';
import CodePanel from '../components/landing/CodePanel.astro';
import Dock from '../components/landing/Dock.astro';
import InstallChip from '../components/landing/InstallChip.astro';
import Section from '../components/landing/Section.astro';
import Header from '../components/lcars/Header.astro';
import NavButton from '../components/lcars/NavButton.astro';
import Landing from '../layouts/Landing.astro';
import { stardate } from '../lib/stardate';
import { ts, inlineCode } from '../lib/template-helpers';
import { withBase } from '../lib/url';

const guide = withBase('/docs/getting-started/');
const api = withBase('/docs/reference/core/');
const why = withBase('/docs/why/');
const github = 'https://github.com/texel/hypospray';

const cases = [
  {
    title: 'Test without mocking imports',
    body: 'Give each test its own fake dependencies, without rewriting imports or changing your application code.',
    // A flask with a check mark.
    icon: 'M27 12h18 M31 12v19L18 52a7 7 0 0 0 6 10h25a7 7 0 0 0 6-10L41 31V12 M25 43h22 M29 52l5 5 10-11',
  },
  {
    title: 'Configure your app in one place',
    body: 'Provide configuration for components and services without passing it through everything in between.',
    // Three independently adjustable controls.
    icon: 'M15 19h17 M42 19h15 M15 36h7 M32 36h25 M15 53h25 M50 53h7 M32 13h10v12H32z M22 30h10v12H22z M40 47h10v12H40z',
  },
  {
    title: 'Change implementations without changing callers',
    body: 'Switch between real and fake APIs, browser and server clients, or different providers without updating the code that uses them.',
    // Arrows exchanging two interchangeable blocks.
    icon: 'M12 29h18v18H12z M42 29h18v18H42z M21 20c8-12 22-12 30 0 M44 19l7 1 1-7 M51 56c-8 12-22 12-30 0 M28 57l-7-1-1 7',
  },
  {
    title: 'Share services without global state',
    body: 'Reuse the same client across your app, while giving each test or feature its own instance when needed.',
    // A shared service connected to three separate consumers.
    icon: 'M28 10h16v16H28z M36 26v13 M15 48V39h42v9 M36 39v9 M8 48h14v14H8z M29 48h14v14H29z M50 48h14v14H50z',
  },
];

const steps = [
  {
    title: 'Ask for configuration',
    body: 'Define a default configuration. Your service asks for it with `inject()`.',
    file: 'orders.ts',
    code: ts`
export const getConfig = () => ({
  apiUrl: '/api',
});

export function getOrdersApi(
  config = inject(getConfig)
) {
  return {
    list: () => fetch(config.apiUrl + '/orders'),
  };
}
`,
  },
  {
    title: 'Customize it for your app',
    body: 'Supply your configuration at startup. Hypospray builds the orders API using that value.',
    file: 'main.ts',
    code: ts`
const app = createInjector({
  providers: [
    provideValue(getConfig, {
      apiUrl: 'https://example.com/api',
    }),
  ],
});

const orders = app.get(getOrdersApi);
`,
  },
  {
    title: 'Mock the API in a test',
    body: 'Your code is testable out of the box, and common sources of flakiness are gone.',
    file: 'orders.test.ts',
    code: ts`
const fakeOrders = {
  list: async () => Response.json([]),
};

const testApp = createInjector({
  providers: [
    provideValue(getOrdersApi, fakeOrders),
  ],
});

const orders = testApp.get(getOrdersApi);
expect(await (await orders.list()).json()).toEqual([]);
`,
  },
];

// Placeholder tiles until the real logos are in. Any number works: the grid wraps.
const platforms = [
  'React',
  'Vue',
  'Svelte',
  'Solid',
  'Angular',
  'Node',
  'Bun',
  'Deno',
  'TypeScript',
  'JavaScript',
];

const features = [
  {
    title: 'Skip the manual wiring',
    body: 'Dependencies are built automatically when needed, so adding a service doesn’t mean updating a central construction sequence.',
  },
  {
    title: 'Give each feature its own configuration',
    body: 'Customize a search page or another part of your app while keeping shared defaults everywhere else.',
  },
  {
    title: 'Run different implementations side by side',
    body: 'Let two parts of the same page use different clients or services without interfering with each other.',
  },
  {
    title: 'See where dependency resolution went wrong',
    body: 'Get useful context when a dependency can’t be built, making failures easier to track down.',
  },
];
---

<Landing
  title="Hypospray — painless dependency injection for TypeScript"
  description="Make your app easier to configure, test, and maintain with Hypospray, a dependency injection library for TypeScript."
>
  <Header slot="header" homeHref="#">
    <NavButton href="#why" section="why" hue="var(--why)" label="WHY" />
    <NavButton href="#how" section="how" hue="var(--how)" label="HOW" />
    <NavButton href="#features" section="features" hue="var(--uses)" label="FEATURES" />
    <NavButton href={withBase('/docs/')} hue="var(--docs)" label="DOCS" />
  </Header>

  <div class="hdr-spacer">
    <div data-header-sentinel></div>
  </div>

  <Section id="hero" hue="var(--frame)" dim="var(--hero-dim)">
    <div class="hero">
      <div class="hero-copy">
        <h1>Painless dependency injection for TypeScript.</h1>
        <p class="lede">Make your app easier to configure, test, and maintain.</p>
      </div>
      <div class="actions">
        <Button href={guide}>Get started</Button>
        <InstallChip command="npm i @hypospray/core" />
      </div>
    </div>
  </Section>

  <Section id="why" name="Why" hue="var(--why)" dim="var(--why-dim)">
    <h2>You're already managing dependencies.</h2>
    <p class="lede">You could use some help.</p>

    <ul class="cases">
      {cases.map((c) => (
        <li class="case">
          <div class="case-illustration" aria-hidden="true">
            <svg
              viewBox="0 0 72 72"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d={c.icon} />
            </svg>
          </div>
          <div class="case-copy">
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </div>
        </li>
      ))}
    </ul>
    <p class="more">
      <a href={why}>Why imports, props, and context get awkward</a>
    </p>
  </Section>

  <Section id="how" name="How" hue="var(--how)" dim="var(--how-dim)">
    <h2>Ask for what you need, choose what you get.</h2>
    <p class="lede wide">
      Hypospray builds your dependencies when they’re needed, including anything they depend on. You
      don’t have to construct them yourself or keep the wiring in order.
    </p>
    <ol class="steps">
      {steps.map((step, i) => (
        <li class="step">
          <div class="step-copy">
            <h3>
              <span class="num">{i + 1}</span> {step.title}
            </h3>
            <p set:html={inlineCode(step.body)} />
          </div>
          <CodePanel
            file={step.file}
            code={step.code}
            lang="ts"
            hue="var(--how)"
            dim="var(--how-dim)"
          />
        </li>
      ))}
    </ol>
  </Section>

  <Section id="features" name="Features" hue="var(--uses)" dim="var(--uses-dim)" last>
    <h2>Fits the way you already write TypeScript.</h2>
    <ul class="platforms" aria-label="Works with">
      {platforms.map((name) => (
        <li>{name}</li>
      ))}
    </ul>
    <p class="platforms-caption">
      Adapters for the frameworks you already use, and a core that works with plain TypeScript or
      JavaScript.
    </p>

    <div class="features">
      {features.map((f) => (
        <div>
          <h3>{f.title}</h3>
          <p set:html={inlineCode(f.body)} />
        </div>
      ))}
    </div>

    <div class="cta">
      <div>
        <p class="cta-title">Ready when you are.</p>
        <p>Read the guide, or go straight to the API.</p>
      </div>
      <div class="cta-actions">
        <Button href={guide}>Get started</Button>
        <Button href={api} variant="secondary" hue="var(--why)">
          API reference
        </Button>
        <Button href={github} variant="secondary" hue="var(--uses)">
          GitHub
        </Button>
      </div>
    </div>
    <footer class="footer">
      <span>MIT License</span>
      <span>© 2026 Leigh Caplan</span>
      <span>Stardate {stardate(new Date())}</span>
    </footer>
  </Section>

  <Dock slot="dock" />
</Landing>

<style>
  .hdr-spacer {
    position: relative;
    height: 184px;
  }

  /* Compact once content has risen to the compact header's bottom edge (86px), so the morph never leaves a gap. */
  [data-header-sentinel] {
    position: absolute;
    top: calc(184px - 86px);
    width: 1px;
    height: 1px;
  }

  :global(main section[id]) {
    scroll-margin-top: 86px;
  }

  @media (600px <= width < 1050px) {
    .hdr-spacer {
      height: 92px;
    }
  }

  @media (width < 600px) {
    .hdr-spacer {
      height: 70px;
    }

    [data-header-sentinel] {
      top: calc(70px - 46px);
    }

    :global(main section[id]) {
      scroll-margin-top: 46px;
    }

    :global(body) {
      padding-bottom: 110px;
    }
  }

  h1,
  h2,
  h3,
  .cta-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    color: var(--text);
  }

  /* Antonio's capitals carry ~0.064em of left bearing; pull it back so the ink sits on the content edge, under the title's. */
  h1 {
    font-size: 64px;
    line-height: 1;
    margin-left: -0.064em;
  }

  h2 {
    max-width: 22ch;
    font-size: 44px;
    line-height: 1.05;
    margin-bottom: 20px;
  }

  h3 {
    font-size: 24px;
    line-height: 1.2;
    margin-bottom: 8px;
  }

  .lede {
    max-width: 36ch;
    margin: 24px 0 32px;
    font-size: 21px;
    line-height: 1.5;
  }

  .lede.wide {
    max-width: 60ch;
    margin-top: 0;
  }

  p {
    font-size: 18px;
    line-height: 1.5;
  }

  p :global(code),
  .lede code {
    font-family: var(--font-code);
    font-size: 0.85em;
    color: var(--docs);
  }

  .hero {
    display: grid;
    gap: 32px;
  }

  .hero h1 {
    max-width: 22ch;
  }

  .hero .lede {
    margin-bottom: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }

  .cases {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }

  .case {
    min-width: 0;
  }

  .case-illustration {
    display: flex;
    align-items: center;
    height: 112px;
    margin-bottom: 20px;
    color: var(--text-muted);
  }

  .case-illustration svg {
    width: 88px;
    height: 88px;
  }

  .case h3 {
    color: var(--hue);
  }

  .case p {
    margin: 0;
  }

  .num {
    display: inline-block;
    min-width: 1.4em;
    color: var(--text-muted);
  }

  .more {
    margin: 56px 0 0;
  }

  .more a {
    color: var(--text);
    text-decoration-color: var(--hue);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .steps {
    display: grid;
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 32px;
    align-items: start;
  }

  .step-copy p {
    max-width: 38ch;
    margin: 0;
  }

  .step h3,
  .features h3 {
    color: var(--hue);
  }

  .platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .platforms li {
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--dim);
    color: var(--hue);
    font-family: var(--font-display);
    font-size: 16px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .platforms-caption {
    margin: 16px 0 56px;
    color: var(--text-muted);
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 32px;
  }

  .features p {
    margin: 0;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    margin-top: 96px;
  }

  .cta-title {
    font-size: 36px;
  }

  .cta p {
    margin: 4px 0 0;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 48px;
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  @media (width < 1050px) {
    .cases,
    .step {
      grid-template-columns: minmax(0, 1fr);
    }

    .case {
      display: grid;
      grid-template-columns: 160px minmax(0, 1fr);
      gap: 24px;
    }

    .case-illustration {
      margin-bottom: 0;
    }
  }

  @media (width < 600px) {
    .case {
      grid-template-columns: minmax(0, 1fr);
    }

    h1 {
      font-size: 44px;
    }

    h2 {
      font-size: 32px;
    }
  }
</style>
