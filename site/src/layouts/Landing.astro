---
import { Font } from 'astro:assets';

import { withBase } from '../lib/url';

import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={withBase('/favicon.png?v=2')} type="image/png" sizes="32x32" />
    <link rel="icon" href={withBase('/favicon.svg?v=2')} type="image/svg+xml" sizes="any" />
    <title>{title}</title>
    <Font cssVariable="--font-antonio" preload={[{ weight: 700 }]} />
    <Font cssVariable="--font-barlow" />
    <Font cssVariable="--font-jetbrains" />
  </head>
  <body>
    <slot name="header" />
    <main id="top">
      <slot />
    </main>
    <slot name="dock" />
  </body>
</html>

<style>
  html {
    background: var(--bg);
    color: var(--text-body);
    font-family: var(--font-body);
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    max-width: var(--page-max);
    margin: 0 auto;
    background: var(--bg);
  }

  /* The header is fixed, so it's placed against the viewport and needs the same cap as the body. */
  :global(.lcars-header) {
    max-width: var(--page-max);
    margin-inline: auto;
  }

  /* The page-wide reset reaches every component's markup. */
  :global(*),
  :global(*::before),
  :global(*::after) {
    box-sizing: border-box;
  }
</style>
