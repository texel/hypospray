---
/**
 * Steps that swap one diagram as you scroll. Write each step as a `<Step diagram={…}>` holding
 * Markdown, and pass the same diagrams, in order, as `diagrams`: given room, they're stacked on a
 * sticky stage beside the steps, and the step crossing the middle of the viewport picks one.
 */
import InjectDiagram from './InjectDiagram.astro';
import TreeDiagram from './TreeDiagram.astro';

interface Props {
  diagrams: Record<string, unknown>[];
  /** What draws them: a tree, unless said otherwise. */
  as?: typeof TreeDiagram | typeof InjectDiagram;
  /** Space between steps, in px, for steps too short to give the scroll room on their own. */
  gap?: number;
}
const { diagrams, as = TreeDiagram, gap } = Astro.props;
// The diagrams' props are passed through as they come, unchecked, whichever draws them.
const Diagram = as as typeof TreeDiagram;
---

<div class="stepper" data-stepper style={gap === undefined ? undefined : `--step-gap: ${gap}px`}>
  <div class="stepper-body">
    <div class="steps">
      <slot />
    </div>
    <div class="stage" aria-hidden="true">
      {diagrams.map((diagram) => (
        <div class="stage-frame">
          <Diagram {...diagram} />
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .stepper {
    /* Space between steps: with each step's own text, how far you scroll from one to the next. */
    --step-gap: 60px;

    /* Side by side once the stepper itself has the room, wherever it sits on the page. */
    container-type: inline-size;
  }

  .stepper .stage {
    display: none;
  }

  /*
   * The page's prose spaces each element after a sibling: not here, where frames stack in one
   * cell (the first would sit higher than the rest) and steps are spaced by --step-gap.
   */
  .stepper :global(.step),
  .stepper .stage-frame {
    margin-top: 0;
  }

  /* Two in a row read as two pictures, not one (the first one on the page is followed by its script). */
  .stepper + .stepper,
  .stepper + :global(script) + .stepper {
    margin-top: 56px;
  }

  @container (min-width: 760px) {
    .stepper[data-live] .stepper-body {
      display: grid;
      grid-template-columns: 240px minmax(0, 1fr);
      gap: 32px;
    }

    .stepper[data-live] :global(.step-art) {
      display: none;
    }

    /*
     * The stage pins centred in the viewport (--pin-top, set by the script), and everything lines
     * up on its top edge: the first step starts there, and each next one takes over as it scrolls
     * up to it. Then the active step always sits beside the top of the picture.
     */
    .stepper[data-live] .stage {
      display: grid;
      position: sticky;
      top: var(--pin-top, var(--sl-nav-height, 16px));
      align-self: start;
    }

    /* A step's height plus the gap is how far you scroll before the next one takes over. */
    .stepper[data-live] :global(.step) {
      /* The box is exactly its text: no paragraph margins leaking out to throw the measuring off. */
      display: flow-root;
      margin-bottom: var(--step-gap);
      padding-left: 14px;
      border-left: 3px solid var(--d-faint);

      /* Linked to, a step lands on the line that activates it. */
      scroll-margin-top: var(--pin-top, var(--sl-nav-height, 16px));
    }

    .stepper[data-live] :global(.step:last-child) {
      margin-bottom: 0;
    }

    .stepper[data-live] :global(.step > p:first-of-type) {
      margin-top: 0;
    }

    .stepper[data-live] :global(.step > p:last-of-type) {
      margin-bottom: 0;
    }

    /*
     * Room after the last step (--tail, measured), so the stage stays pinned until the last step
     * reaches its top; from there the whole stepper, picture and all, scrolls on as one.
     */
    .stepper[data-live] .steps {
      padding-bottom: var(--tail, 0);
    }

    .stepper[data-live] :global(.step[data-active]) {
      border-left-color: var(--d-blue);
    }

    /* A wide diagram fits the stage's column, rather than breaking out of it; a narrow one keeps its size. */
    .stepper .stage-frame :global(.tree.wide),
    .stepper .stage-frame :global(.inject) {
      width: min(100%, var(--view-width));
      margin-left: 0;
      transform: none;
    }

    .stepper .stage-frame {
      grid-area: 1 / 1;
      opacity: 0;
      transition: opacity calc(250ms * var(--motion-scale)) var(--motion-ease);
    }

    .stepper .stage-frame[data-active] {
      opacity: 1;
    }
  }
</style>

<script>
  /**
   * How close to the stage's top edge a step has to scroll before it takes over, as a fraction of
   * the stage's height. 0: right at the edge. Higher: sooner, while the step before is still in view.
   */
  const TAKEOVER = 0.2;

  for (const stepper of document.querySelectorAll<HTMLElement>('[data-stepper]')) {
    const steps = [...stepper.querySelectorAll<HTMLElement>('[data-step]')];
    const frames = [...stepper.querySelectorAll<HTMLElement>('.stage-frame')];
    const activate = (n: number) => {
      steps.forEach((step, i) => step.toggleAttribute('data-active', i === n));
      frames.forEach((frame, i) => frame.toggleAttribute('data-active', i === n));
    };
    steps.forEach((step, i) => (step.dataset.step = String(i)));
    const stage = stepper.querySelector<HTMLElement>('.stage');
    let pinTop = 16;
    let line = 16;
    const layout = () => {
      if (!stage) return;
      // Centred in what the page's fixed header leaves of the viewport.
      const header = parseFloat(getComputedStyle(stepper).getPropertyValue('--sl-nav-height')) || 0;
      const height = stage.offsetHeight;
      pinTop = Math.max(header + 16, header + (innerHeight - header - height) / 2);
      stepper.style.setProperty('--pin-top', `${pinTop}px`);
      line = pinTop + height * TAKEOVER;
      const last = steps.at(-1);
      const tail = last ? Math.max(0, height - last.offsetHeight) : 0;
      stepper.style.setProperty('--tail', `${tail}px`);
    };
    // The active step is the last one whose top has come within TAKEOVER of the stage's top edge
    // (or the first, before any has).
    let current = -1;
    const update = () => {
      const reached = steps.filter((step) => step.getBoundingClientRect().top <= line);
      const n = Math.max(0, reached.length - 1);
      if (n !== current) activate((current = n));
    };
    let queued = false;
    addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          update();
        });
      },
      { passive: true },
    );
    if (stage) new ResizeObserver(layout).observe(stage);
    addEventListener('resize', layout);
    // Live first: until then the stage is hidden, and has no height to measure.
    stepper.dataset.live = '';
    layout();
    update();
  }
</script>
