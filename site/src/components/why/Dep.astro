---
/** A service's icon, inline in prose: `<Dep name="config" />`. */
import { type Dep, deps } from './deps';

interface Props {
  name: Dep;
}
const { name } = Astro.props;
---

<svg class="dep" viewBox="0 0 16 16" aria-hidden="true" set:html={deps[name].icon} />

<style>
  /* Sized to the text around it, whether that's a legend or a heading. */
  .dep {
    display: inline-block;
    width: 0.9em;
    height: 0.9em;
    vertical-align: -0.1em;
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
