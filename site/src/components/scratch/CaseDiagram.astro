---
import { codeToTokens } from 'shiki';

import { deps } from './deps';
import { CH, H, ICON, ICON_STEP, contentWidth, segment } from './text';

/**
 * One use case, zoomed in: the pieces that ask for a dependency (left), the default they'd get
 * (ghosted) and what they get instead (right), and under that, the file that makes the swap,
 * with its code. Beats 3 and 7 draw the same cases with this, so only the mechanism changes.
 */
type Tone = 'purple' | 'blue';
interface Box {
  text: string;
  /** Drawn as a file, with this name in its bottom bar. Without one: a component or a value. */
  file?: string;
  component?: boolean;
}
interface Props {
  tone: Tone;
  consumers: Box[];
  /** What they'd get by default, ghosted. Leave out when the swap happens in place. */
  original?: Box;
  replacement: Box;
  control: { file: string; code: string };
  /** The catch (or the lack of one), under the code. */
  note?: string;
}
const { tone, consumers, original, replacement, control, note } = Astro.props as Props;

const BAR = 16;
const EAR = 10;
const LINE = 18;
const RADIUS = 8;
const GAP = 12;
const boxH = (box: Box) => (box.file ? H + BAR + 2 : H);
const boxW = (box: Box) => Math.max(120, Math.round(contentWidth(box.text) + 28));

// Consumers stacked on the left, around a shared centre line.
const cw = Math.max(...consumers.map(boxW));
const cx = 10 + cw / 2;
const stackH = consumers.reduce((sum, c) => sum + boxH(c), 0) + GAP * (consumers.length - 1);
const top = 20;
const mid = top + Math.max(stackH, original ? 2 * 48 + 24 : 48) / 2;
let y = mid - stackH / 2;
const placedConsumers = consumers.map((c) => {
  const h = boxH(c);
  const node = Object.assign({}, c, { x: cx, y: y + h / 2, w: cw, h });
  y += h + GAP;
  return node;
});

// The default above the line, the replacement below it (or on it, if there's no default).
const tw = Math.max(boxW(replacement), original ? boxW(original) : 0);
const tx = cx + cw / 2 + 80 + tw / 2;
const placedOriginal = original && {
  ...original,
  x: tx,
  y: mid - 36,
  w: tw,
  h: boxH(original),
};
const placedReplacement = {
  ...replacement,
  x: tx,
  y: original ? mid + 36 : mid,
  w: tw,
  h: boxH(replacement),
};

// The file that makes the swap: under the replacement, its arrow pointing up into it. Its code is
// highlighted at build time, by file extension, one row of coloured runs per line.
const lang = control.file.startsWith('.env')
  ? 'dotenv'
  : control.file.endsWith('.tsx')
    ? 'tsx'
    : 'ts';
const { tokens } = await codeToTokens(control.code, { lang, theme: 'github-light' });
const lines = control.code.split('\n');
/** Shiki's FontStyle.Italic bit (the enum itself is type-only). */
const ITALIC = 1;
const codeW = Math.max(...lines.map((line) => line.length * CH)) + 28;
const codeH = lines.length * LINE + 16 + BAR;
const codeTop =
  Math.max(
    placedReplacement.y + placedReplacement.h / 2,
    ...placedConsumers.map((c) => c.y + c.h / 2),
  ) + 40;
const codeLeft = Math.max(10, tx - 70);
const codeBox = { x: codeLeft + codeW / 2, y: codeTop + codeH / 2, w: codeW, h: codeH };
const viewWidth = Math.max(tx + tw / 2, codeLeft + codeW) + 10;
const viewHeight = codeTop + codeH + (note ? 30 : 12);

type Pt = [number, number];
const rounded = (pts: Pt[]) => {
  let d = `M ${pts[0]![0]} ${pts[0]![1]}`;
  for (let i = 1; i < pts.length - 1; i++) {
    const [px, py] = pts[i - 1]!;
    const [qx, qy] = pts[i]!;
    const [nx, ny] = pts[i + 1]!;
    const r = Math.min(RADIUS, Math.hypot(qx - px, qy - py) / 2, Math.hypot(nx - qx, ny - qy) / 2);
    const a = [qx - Math.sign(qx - px) * r, qy - Math.sign(qy - py) * r];
    const b = [qx + Math.sign(nx - qx) * r, qy + Math.sign(ny - qy) * r];
    d += ` L ${a[0]} ${a[1]} Q ${qx} ${qy} ${b[0]} ${b[1]}`;
  }
  const last = pts.at(-1)!;
  return `${d} L ${last[0]} ${last[1]}`;
};
/** Out of a consumer's right side, down (or up) a lane, into the target's left side. */
const edge = (
  from: (typeof placedConsumers)[number],
  to: { x: number; y: number; w: number },
  dy: number,
  lane: number,
) => {
  const start: Pt = [from.x + from.w / 2, from.y + dy];
  const end: Pt = [to.x - to.w / 2 - 4, to.y];
  if (Math.abs(start[1] - end[1]) < 1) return rounded([start, end]);
  return rounded([start, [lane, start[1]], [lane, end[1]], end]);
};
const left = tx - tw / 2;
const uid = Math.random().toString(36).slice(2, 8);
const nodes = [
  ...placedConsumers.map((n) => Object.assign({}, n, { mark: undefined as string | undefined })),
  ...(placedOriginal ? [{ ...placedOriginal, mark: 'ghost' }] : []),
  { ...placedReplacement, mark: `${tone}-soft` },
];
---

<svg
  class="case"
  viewBox={`0 0 ${viewWidth} ${viewHeight}`}
  style={`--view-width: ${viewWidth}px`}
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    {Object.entries(deps).map(([dep, { icon }]) => (
      <symbol id={`${uid}-${dep}`} viewBox="0 0 16 16" class="icon" set:html={icon} />
    ))}
    {['plain', tone].map((t) => (
      <marker
        id={`${uid}-${t}`}
        class={`tip ${t}`}
        viewBox="0 0 8 8"
        refX="4"
        refY="4"
        markerWidth="8"
        markerHeight="8"
        markerUnits="userSpaceOnUse"
        orient="auto"
      >
        <path d="M0,0 L8,4 L0,8 z" />
      </marker>
    ))}
  </defs>

  {/* Default edges first, faded, so the live ones sit on top. */}
  {placedOriginal &&
    placedConsumers.map((c) => (
      <path
        class="edge ghost"
        d={edge(c, placedOriginal, original ? -6 : 0, left - 40)}
        marker-end={`url(#${uid}-plain)`}
      />
    ))}
  {placedConsumers.map((c) => (
    <path
      class:list={['edge', tone]}
      d={edge(c, placedReplacement, original ? 6 : 0, left - 22)}
      marker-end={`url(#${uid}-${tone})`}
    />
  ))}
  <path
    class:list={['edge', tone]}
    d={rounded([
      [tx, codeTop],
      [tx, placedReplacement.y + placedReplacement.h / 2 + 4],
    ])}
    marker-end={`url(#${uid}-${tone})`}
  />

  {nodes.map((node) => {
    const [l, r, t, b] = [
      node.x - node.w / 2,
      node.x + node.w / 2,
      node.y - node.h / 2,
      node.y + node.h / 2,
    ];
    let x = node.x - contentWidth(node.text) / 2;
    const textY = node.file ? node.y - BAR / 2 : node.y;
    return (
      <g class="node" data-mark={node.mark}>
        {node.file ? (
          <>
            <path class="shape" d={`M ${l} ${t} H ${r - EAR} L ${r} ${t + EAR} V ${b} H ${l} Z`} />
            <path class="bar" d={`M ${l} ${b - BAR} H ${r} V ${b} H ${l} Z`} />
            <path class="ear" d={`M ${r - EAR} ${t} V ${t + EAR} H ${r}`} />
            <text class="file" x={node.x} y={b - BAR / 2}>
              {node.file}
            </text>
          </>
        ) : (
          <rect
            class="shape"
            x={l}
            y={t}
            width={node.w}
            height={node.h}
            rx={node.component ? 3 : 15}
          />
        )}
        {segment(node.text).map((seg) => {
          const at = x;
          x += 'icon' in seg ? ICON_STEP : seg.text.length * CH;
          return 'icon' in seg ? (
            <use
              class="icon"
              href={`#${uid}-${seg.icon}`}
              x={at}
              y={textY - ICON / 2}
              width={ICON}
              height={ICON}
            />
          ) : (
            <text x={at} y={textY} textLength={seg.text.length * CH}>
              {seg.text}
            </text>
          );
        })}
      </g>
    );
  })}

  {/* The file that makes the swap, as a document holding its code. */}
  {(() => {
    const [l, r, t, b] = [
      codeBox.x - codeBox.w / 2,
      codeBox.x + codeBox.w / 2,
      codeBox.y - codeBox.h / 2,
      codeBox.y + codeBox.h / 2,
    ];
    return (
      <g class="node code" data-mark={tone}>
        <path class="shape" d={`M ${l} ${t} H ${r - EAR} L ${r} ${t + EAR} V ${b} H ${l} Z`} />
        <path class="bar" d={`M ${l} ${b - BAR} H ${r} V ${b} H ${l} Z`} />
        <text class="file" x={codeBox.x} y={b - BAR / 2}>
          {control.file}
        </text>
        {/* Plain text: icons would land inside path strings like './orders'. */}
        {lines.map((line, row) => (
          <text x={l + 14} y={t + 8 + LINE / 2 + row * LINE} textLength={line.length * CH}>
            {(tokens[row] ?? []).map((token) => (
              <tspan
                fill={token.color}
                font-style={(token.fontStyle ?? 0) & ITALIC ? 'italic' : undefined}
              >
                {token.content}
              </tspan>
            ))}
          </text>
        ))}
      </g>
    );
  })()}
  {note && (
    <text class:list={['note', tone]} x={codeLeft} y={codeTop + codeH + 18}>
      {note}
    </text>
  )}
</svg>

<style>
  .case {
    display: block;
    width: min(var(--view-width), 100vw - 32px);
    max-width: none;
    height: auto;
    margin: 16px 0 8px 50%;
    transform: translateX(-50%);
    overflow: visible;
    font-family: ui-monospace, monospace;
    font-size: 12px;
  }
  .purple {
    --tone: #84c;
    --soft: #f2e6fa;
  }
  .blue {
    --tone: #36c;
    --soft: #e2eaff;
  }
  [data-mark^='purple'] {
    --tone: #84c;
    --soft: #f2e6fa;
  }
  [data-mark^='blue'] {
    --tone: #36c;
    --soft: #e2eaff;
  }
  .edge {
    fill: none;
    stroke: #999;
    stroke-width: 1.5;
  }
  .edge.purple,
  .edge.blue {
    stroke: var(--tone);
    stroke-width: 3;
  }
  .edge.ghost {
    opacity: 0.35;
    stroke-dasharray: 5 3;
  }
  .tip.plain path {
    fill: #999;
  }
  .tip:not(.plain) path {
    fill: var(--tone);
  }
  .node {
    color: #222;
  }
  .node .shape {
    fill: #f2f2f2;
    stroke: #999;
  }
  [data-mark$='-soft'] .shape {
    fill: var(--soft);
    stroke: var(--tone);
    stroke-width: 2;
  }
  [data-mark='ghost'] .shape {
    fill: none;
    stroke-dasharray: 4 3;
  }
  [data-mark='ghost'] {
    color: #aaa;
  }
  /* The swap's own file: white, with a coloured outline, so the code reads. */
  .code .shape {
    fill: #fff;
    stroke: var(--tone);
    stroke-width: 2;
  }
  .node text {
    dominant-baseline: central;
    white-space: pre;
    fill: currentColor;
  }
  .file {
    opacity: 0.75;
    font-size: 10px;
    text-anchor: middle;
  }
  .bar {
    fill: rgb(0 0 0 / 0.1);
  }
  .ear {
    fill: none;
    stroke: #999;
  }
  [data-mark$='-soft'] .ear {
    stroke: var(--tone);
  }
  .icon {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .note {
    font-size: 11px;
    font-style: italic;
    fill: var(--tone);
  }
</style>
