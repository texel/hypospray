        { x: rootNode.x - rootNode.w / 2 + 12 + BADGE_R, y: lineY },
        { x: node.x - node.w / 2 + 2, y: node.y - node.h / 2 + 1 },
      ].map(({ x, y }) => (
        <g class="badge">
          <circle cx={x} cy={y} r={BADGE_R} />
          <text x={x} y={y}>
            {i + 1}
          </text>
        </g>
      ));
    })}
  {/* Edge labels last, so their boxes sit over everything they cross. */}
  {boxes.map((box) => {
    const { x: cx, y: cy, tone, ghost } = box;
    const call = 'call' in box && box.call ? callOf(box.text) : undefined;
    const text = call ? call.arg : box.text;
    // Just an icon: a small round pill. Anything with text gets more room.
    const pad = segment(text).every((seg) => 'icon' in seg) ? 3 : 6;
    const w = labelWidth(text) + pad * 2 - (pad === 3 ? 2 : 0);
    // A call: the argument indented under `inject(`, over `)`, the container its only pill.
    const block = call && {
      l: cx - callWidth(box.text) / 2 + CALL.pad,
      r: cx + callWidth(box.text) / 2 - CALL.pad,
      slotT: cy - LABEL_H / 2,
      slotB: cy + LABEL_H / 2,
    };
    const px = block ? block.r - w / 2 : cx;
    let x = px - w / 2 + pad;
    return (
      <g class:list={['pill', tone, { ghost, call: block }]}>
        {block && call && (
          <>
            <rect
              class="call-box"
              x={block.l - CALL.pad}
              y={block.slotT - CALL.top}
              width={block.r - block.l + CALL.pad * 2}
              height={CALL_H}
              rx={CALL.radius}
            />
            <text class="call-label" x={block.l} y={block.slotT - CALL.top / 2 + 1}>
              {call.fn}(
            </text>
            <text class="call-label" x={block.l} y={block.slotB + CALL.bottom / 2 - 1}>
              )
            </text>
          </>
        )}
        {!block && (
          <rect x={px - w / 2} y={cy - LABEL_H / 2} width={w} height={LABEL_H} rx={LABEL_H / 2} />
        )}
        {segment(text).map((seg) => {
          const start = x;
          if ('icon' in seg) {
            x += 14;
            return (
              <use
                class="icon label-icon"
                href={`#${uid}-${seg.icon}`}
                x={start}
                y={cy - 6}
                width="12"
                height="12"
              />
            );
          }
          x += seg.text.length * LABEL_CH;
          return (
            <text class="edge-label" x={start} y={cy} textLength={seg.text.length * LABEL_CH}>
              {seg.text}
            </text>
          );
        })}
      </g>
    );
  })}
  {[...Object.entries(notes), ...(root?.note ? ([['Root', root.note]] as const) : [])].map(
    ([id, note]) => {
      const node = nodes[id]!;
      const [text, side, tone] = typeof note === 'string' ? [note, 'right'] : note;
      const at = {
        right: { x: node.x + node.w / 2 + 8, y: node.y, anchor: 'start' },
        left: { x: node.x - node.w / 2 - 8, y: node.y, anchor: 'end' },
        below: { x: node.x, y: node.y + node.h / 2 + 14, anchor: 'middle' },
      }[side as Side];
      return (
        <text class:list={['note', tone]} x={at.x} y={at.y} text-anchor={at.anchor}>
          {text}
        </text>
      );
    },
  )}
</svg>

