---
import { type Dep, deps } from './deps';
import { CH, H, ICON, ICON_STEP, contentWidth, segment } from './text';

/**
 * Lo-fi diagram for the Why scratch page: a component tree on top, the services the leaves use
 * below. Each beat passes marks, edge colours, labels and notes to tell its part of the story.
 *
 * Colours carry a flow: a solid mark is where it starts, a soft mark is everything it reaches.
 * Edges are keyed `from>to`.
 */
type Tone = 'red' | 'purple' | 'orange' | 'blue' | 'green';
/** `hidden`: not there at all yet, e.g. a service the injector hasn't built. */
type Mark = Tone | `${Tone}-soft` | 'ghost' | 'hidden';
type Side = 'left' | 'right' | 'below';
interface Props {
  marks?: Record<string, Mark>;
  edges?: Record<string, Tone>;
  /** Replaces a node's text, e.g. to show the props it takes. */
  labels?: Record<string, string>;
  edgeLabels?: Record<string, string>;
  /** Text beside a node, on the right unless given a side; a tone colours it. */
  notes?: Record<string, string | [string, Side] | [string, Side, Tone]>;
  /**
   * Labels every component→service edge (`import`, `prop`, `inject()`…). `$dep` becomes the
   * target service's name, which gets its icon: `import { $dep }`.
   */
  uses?: string;
  /** Labels every service→service edge. */
  needs?: string;
  /** Adds a node above `<App>` for whatever builds and renders it. */
  root?: { text: string; mark?: Mark; note?: string; title?: string };
  /** Leaves that reach straight up to `<App>` (context), with the edge label. */
  /** Context lookups from each leaf up to <App>; `$dep` in the label is what that leaf takes. */
  teleport?: { from: string[]; label: string; broken?: string[] };
  /** Draws an edge as one thin line per dependency it carries, each with its own icon. */
  strands?: Record<string, Dep[]>;
  /**
   * Numbers the services in the order the root builds them, line `i` of its code building
   * `order[i]`: the same numbered badge on the line and on the service.
   */
  order?: string[];
  /** Tips the tree's edges with little drill bits instead of plain arrowheads: prop drilling. */
  drill?: boolean;
  /** The dependency just added: its strands, their pills and its icons in components, in green. */
  highlight?: Dep;
  /**
   * `below` hangs each service under the component that uses it. `beside` moves the service graph
   * up next to the root, framed together with it: for when the root builds everything.
   * `outline`: the tree as an outline, one component per row like a file browser, with the service
   * graph beside it, each service on the row of the component that uses it.
   * `injector`: the tree as an outline, one component per row like a file browser, and the
   * service graph framed as the injector the root creates, beside it. Each service sits on the row
   * of the component that asks for it, so `uses` edges run straight across. The frame keeps its
   * size while services appear in it (hide the rest with `hidden`).
   * `build`: no tree, just the root's code with the service graph it builds under it, framed
   * together.
   */
  layout?: 'below' | 'beside' | 'outline' | 'injector' | 'build';
  /**
   * How service nodes read. `name`: just what it is. `instance`: a file exporting a ready-made
   * `const`, fixed at import. `factory`: a file exporting a function that makes one, so whoever
   * calls it decides what goes in. Instances are pills, factories are clipped boxes.
   */
  services?: 'name' | 'instance' | 'factory';
  /**
   * `services`: the service graph carries the weight, on its own band; components recede to a
   * light outline, there only to show where each service gets used.
   */
  focus?: 'services';
}
const {
  marks = {},
  edges: edgeTones = {},
  labels = {},
  edgeLabels = {},
  notes = {},
  uses,
  needs,
  root,
  teleport,
  strands = {},
  highlight,
  order,
  drill,
  layout = 'below',
  services: serviceStyle = 'name',
  focus,
} = Astro.props as Props;

const depOf: Record<string, Dep> = {
  AuthClient: 'auth',
  OrdersApi: 'orders',
  AnalyticsApi: 'analytics',
  HttpClient: 'http',
  Logger: 'logger',
  Config: 'config',
};
/** The Hypospray factory each service is resolved by, for `$fn` in labels. */
const fnOf: Record<string, string> = {
  AuthClient: 'getAuthClient',
  OrdersApi: 'getOrdersApi',
  AnalyticsApi: 'getAnalyticsApi',
  HttpClient: 'getHttpClient',
  Logger: 'getLogger',
  Config: 'getConfig',
};
const labelText = (key: string, text: string) => {
  const target = key.split('>')[1]!;
  return text.replaceAll('$dep', depOf[target] ?? '').replaceAll('$fn', fnOf[target] ?? '');
};
/** Edge labels sit in a small box over the edge: the middle, or the trunk for routed edges. */
const LABEL_CH = 6.6;
const LABEL_H = 16;
const labelWidth = (text: string) =>
  segment(text).reduce((sum, seg) => sum + ('icon' in seg ? 14 : seg.text.length * LABEL_CH), 0);

/** Labels may span several lines (`\n`); those are left-aligned, like code. */
const LINE = 20;
const linesOf = (text: string) => text.split('\n');
const build = layout === 'build';
/** The root and the service graph framed together; `build` is the same, the graph under the code. */
const beside = layout === 'beside' || build;
const injector = layout === 'injector';
/** The tree as an outline, the service graph beside it on the components' rows. */
const outline = layout === 'outline' || injector;
/** The service graph runs left to right, beside the tree. */
const sideways = beside || outline;
const width = (text: string, min = outline ? 60 : 110) =>
  Math.max(min, Math.round(Math.max(...linesOf(text).map(contentWidth)) + 24));
const height = (text: string) =>
  linesOf(text).length === 1 ? H : linesOf(text).length * LINE + 12;
const base: Record<string, { x: number; y: number; text: string; service?: boolean }> = {
  App: { x: 340, y: 30, text: '<App>' },
  Header: { x: 140, y: 100, text: '<Header>' },
  Dashboard: { x: 450, y: 100, text: '<Dashboard>' },
  UserMenu: { x: 140, y: 170, text: '<UserMenu>' },
  OrdersTable: { x: 340, y: 170, text: '<OrdersTable>' },
  RevenueChart: { x: 550, y: 170, text: '<RevenueChart>' },
  AuthClient: { x: 140, y: 270, text: 'auth client', service: true },
  OrdersApi: { x: 340, y: 270, text: 'orders api', service: true },
  AnalyticsApi: { x: 550, y: 270, text: 'analytics api', service: true },
  HttpClient: { x: 260, y: 345, text: 'http client', service: true },
  Logger: { x: 550, y: 345, text: 'logger', service: true },
  Config: { x: 400, y: 420, text: 'config', service: true },
};
const serviceText: Record<string, { file: string; instance: string; factory: string }> = {
  AuthClient: {
    file: 'auth.ts',
    instance: 'const auth',
    factory: '{auth} getAuthClient()',
  },
  OrdersApi: {
    file: 'orders.ts',
    instance: 'const orders',
    factory: '{orders} getOrdersApi()',
  },
  AnalyticsApi: {
    file: 'analytics.ts',
    instance: 'const analytics',
    factory: '{analytics} getAnalyticsApi()',
  },
  HttpClient: {
    file: 'http.ts',
    instance: 'const http',
    factory: '{http} getHttpClient()',
  },
  Logger: {
    file: 'logger.ts',
    instance: 'const logger',
    factory: '{logger} getLogger()',
  },
  Config: { file: 'config.ts', instance: 'const config', factory: '{config} getConfig()' },
};
const renders = [
  'App>Header',
  'App>Dashboard',
  'Header>UserMenu',
  'Dashboard>OrdersTable',
  'Dashboard>RevenueChart',
];
const usesEdges = ['UserMenu>AuthClient', 'OrdersTable>OrdersApi', 'RevenueChart>AnalyticsApi'];
const needsEdges = [
  'AuthClient>HttpClient',
  'OrdersApi>HttpClient',
  'AnalyticsApi>HttpClient',
  'AnalyticsApi>Logger',
  'HttpClient>Config',
  'Logger>Config',
];
const files = serviceStyle !== 'name' && !beside;
/** File nodes: a line of code over a grey bar with the file name. */
const BAR = 16;
const EAR = 10;
if (files) {
  // Files are taller, so give the graph's rows more room.
  // Labels sit at the top of each edge, so leave room under every row.
  const rows: Record<number, number> = { 270: 285, 345: 415, 420: 530 };
  for (const [id, text] of Object.entries(serviceText)) {
    const node = base[id]!;
    node.text = text[serviceStyle];
    node.y = rows[node.y] ?? node.y;
  }
  // Out from under analytics, so its two edges leave from opposite sides.
  base.Logger!.x = 610;
}
if (beside) {
  // Tree on the left, a compact service graph on the right.
  const moves: Record<string, [number, number, string?]> = {
    App: [235, 30],
    Header: [90, 120],
    Dashboard: [400, 120],
    UserMenu: [90, 210],
    OrdersTable: [285, 210],
    RevenueChart: [510, 210],
    // Left to right, beside the root; y is relative to the root's centre.
    AuthClient: [525, -40, 'auth'],
    OrdersApi: [525, 0, 'orders'],
    AnalyticsApi: [525, 40, 'analytics'],
    HttpClient: [660, -20, 'http'],
    // Level with analytics' lower port, so that edge runs straight.
    Logger: [660, 49, 'logger'],
    Config: [770, 10, 'config'],
  };
  for (const [id, [x, y, text]] of Object.entries(moves)) {
    Object.assign(base[id]!, { x, y }, text ? { text } : {});
  }
}
/**
 * Outline with files: each import is a line of code in the component or file that makes it, above
 * its name, and its edge leaves from that line. Imports are small and quiet, ruled off from the
 * name, which is bold: the name is what the box is. No labels on the edges, so the drawing stays narrow.
 */
const inline = outline && files;
if (outline && !files) {
  for (const [id, text] of Object.entries(depOf)) base[id]!.text = text;
}
if (inline) {
  for (const [id, node] of Object.entries(base)) {
    const imports = [...(uses ? usesEdges : []), ...(needs ? needsEdges : [])]
      .filter((k) => k.startsWith(`${id}>`))
      .map((k) => labelText(k, (k.includes('>') && usesEdges.includes(k) ? uses : needs)!));
    node.text = [...imports, node.text].join('\n');
  }
}
/**
 * Imports inline: a box's imports on a tight pitch, then a rule as far below the last as the first
 * is below the top, then its name. Offsets are from the top of the box.
 */
const IMPORT = { top: 13, pitch: 14, name: 14, bottom: 14 };
const importCount = (text: string) => (inline ? linesOf(text).length - 1 : 0);
const ruleOffset = (imports: number) => IMPORT.top * 2 + (imports - 1) * IMPORT.pitch;
const inlineHeight = (text: string) => ruleOffset(importCount(text)) + IMPORT.name + IMPORT.bottom;
const nodes = Object.fromEntries(
  Object.entries(base).map(([id, node]) => {
    const text = labels[id] ?? node.text;
    const w = width(text, sideways && node.service ? 70 : undefined);
    const file = files && node.service;
    const h = importCount(text) > 0 ? inlineHeight(text) : height(text);
    return [id, { ...node, text, w, h: file ? h + BAR + 2 : h, file }];
  }),
);
// Beside: each column of the service graph left-aligned, on the left edge of its widest node.
if (beside) {
  const columns = Object.groupBy(
    Object.values(nodes).filter((n) => n.service),
    (n) => n.x,
  );
  for (const column of Object.values(columns)) {
    const left = Math.min(...column!.map((n) => n.x - n.w / 2));
    for (const node of column!) node.x = left + node.w / 2;
  }
}
/** Injector: extra room inside the frame's left edge, for the arrowheads coming in. */
const FRAME_INSET = 12;
// A tall <App> grows upward, so the rest of the tree stays put; the root sits above it.
const appNode = nodes.App!;
appNode.y = 30 + H / 2 - appNode.h / 2;
const appTop = appNode.y - appNode.h / 2;
const rootH = root ? height(root.text) : 0;
/** Room left of the root's code for each line's badge. */
const GUTTER = 20;
const BADGE_R = 7;
// Beside, the root sits in a frame, so leave room under it for what's handed to <App>.
const ROOT_GAP = beside ? 60 : 40;
if (root) {
  nodes.Root = {
    x: appNode.x,
    y: appTop - ROOT_GAP - rootH / 2,
    text: root.text,
    w: width(root.text) + (order ? GUTTER : 0),
    h: rootH,
    file: false,
  };
  if (build) {
    // The code at the left; the graph under it, centred.
    const rootNode = nodes.Root;
    rootNode.x = 14 + rootNode.w / 2;
    const graph = Object.values(nodes).filter((n) => n.service);
    const graphTop = Math.min(...graph.map((n) => n.y - n.h / 2));
    const graphLeft = Math.min(...graph.map((n) => n.x - n.w / 2));
    const graphRight = Math.max(...graph.map((n) => n.x + n.w / 2));
    const dx = rootNode.x - (graphLeft + graphRight) / 2;
    const dy = rootNode.y + rootNode.h / 2 + 30 - graphTop;
    for (const node of graph) Object.assign(node, { x: node.x + dx, y: node.y + dy });
  } else if (beside) {
    // Level with the root, and clear of it on the right, however wide its code; further with
    // badges, which sit over each service's corner.
    const graph = Object.values(nodes).filter((n) => n.service);
    const clear = nodes.Root.x + nodes.Root.w / 2 + (order ? 32 : 14);
    const shift = Math.max(0, clear - Math.min(...graph.map((n) => n.x - n.w / 2)));
    for (const node of graph) Object.assign(node, { x: node.x + shift, y: node.y + nodes.Root.y });
  }
}
/** Injector: the outline's rows, each component's depth under the root, top to bottom. */
const OUTLINE: [string, number][] = [
  ['App', 1],
  ['Header', 2],
  ['UserMenu', 3],
  ['Dashboard', 2],
  ['OrdersTable', 3],
  ['RevenueChart', 3],
];
/** Outline components are compact; rows sit this far apart, however tall each one is. */
const COMPONENT_H = 22;
const ROW_GAP = 8;
const INDENT = 24;
const leaves = ['UserMenu', 'OrdersTable', 'RevenueChart'];
/**
 * Injector: each `uses` label is drawn as a call, a bit like a Scratch block: `inject(` small on
 * the line above, the argument indented on its own line, `)` small below, all in one container.
 * The top line leaves room for the descender in `inject(`.
 */
const CALL = { indent: 8, top: 15, bottom: 15, pad: 6, radius: 5 };
/** A row holding a call is as tall as the call. */
const CALL_H = CALL.top + LABEL_H + CALL.bottom;
const callOf = (text: string) => {
  const match = /^(\w+)\((.*)\)$/s.exec(text);
  return match ? { fn: match[1]!, arg: match[2]! } : undefined;
};
const pillWidth = (text: string) => labelWidth(text) + 12;
const callWidth = (text: string) => {
  const call = callOf(text);
  return call ? CALL.pad * 2 + CALL.indent + pillWidth(call.arg) : pillWidth(text);
};
const usesWidth =
  uses && !inline ? Math.max(...usesEdges.map((k) => callWidth(labelText(k, uses)))) : 0;
/** Injector: each leaf's lane up or down to its service, just outside the frame, top leaf outermost. */
const LANE_GAP = 12;
const laneX = (leaf: string, frameX: number) =>
  frameX - 14 - (leaves.length - 1 - leaves.indexOf(leaf)) * LANE_GAP;
/** Room before the frame for the lanes, past the labels. */
const LANES = 14 + leaves.length * LANE_GAP;
/** Gap between columns of the service graph: room for an edge to turn and run into the next. */
const COLUMN_GAP = 40;
/** Outline: where the lanes end and the graph begins (the injector's frame, when there is one). */
let graphEdge = 0;
/** The y of a node's `i`th line of text; a file's lines sit above its name bar. */
const lineY = (node: (typeof nodes)[string], i: number) => {
  const imports = importCount(node.text);
  if (imports > 0) {
    const top = node.y - node.h / 2;
    return i < imports
      ? top + IMPORT.top + i * IMPORT.pitch
      : top + ruleOffset(imports) + IMPORT.name;
  }
  return (node.file ? node.y - BAR / 2 : node.y) + (i - (linesOf(node.text).length - 1) / 2) * LINE;
};
/** Where a box's imports are ruled off from its name. */
const ruleY = (node: (typeof nodes)[string]) =>
  node.y - node.h / 2 + ruleOffset(importCount(node.text));
/** Imports inline: an edge arrives at the last line of its target, the name it imports. */
const entryY = (node: (typeof nodes)[string]) =>
  inline ? lineY(node, linesOf(node.text).length - 1) : node.y;
/** ...and leaves from the import line that makes it. */
const exitY = (key: string) => {
  const source = key.split('>')[0]!;
  const from = nodes[source]!;
  if (!inline) return from.y;
  const out = [...usesEdges, ...needsEdges].filter((k) => k.startsWith(`${source}>`));
  return lineY(from, out.indexOf(key));
};
if (outline) {
  const rootNode = nodes.Root;
  // Depths count from the root: without one, the outline starts a level in.
  const shallower = rootNode ? 0 : 1;
  if (rootNode) Object.assign(rootNode, { x: 2 + rootNode.w / 2, y: rootNode.h / 2 });
  let rowTop = (rootNode?.h ?? 0) + ROW_GAP;
  for (const [id, depth] of OUTLINE) {
    const node = nodes[id]!;
    const lines = linesOf(node.text).length;
    node.h = lines === 1 ? COMPONENT_H : inline ? inlineHeight(node.text) : lines * LINE + 4;
    // How far the row reaches above and below the component's centre.
    let [up, down] = [node.h / 2, node.h / 2];
    const used = usesEdges.find((k) => k.startsWith(`${id}>`));
    if (uses && used) {
      // The service it uses shares its row, so the row fits that too: with imports inline, the
      // service's name level with the component's import line; otherwise centred on the row.
      const service = nodes[used.split('>')[1]!]!;
      if (inline) {
        node.y = 0;
        const exit = lineY(node, 0);
        const above = entryY(service) - (service.y - service.h / 2);
        up = Math.max(up, above - exit + 3);
        down = Math.max(down, service.h - above + exit + 3);
      } else {
        const half = (callOf(uses) ? CALL_H + 6 : H + 6) / 2;
        [up, down] = [Math.max(up, half), Math.max(down, half)];
      }
    }
    Object.assign(node, { x: 2 + (depth - shallower) * INDENT + node.w / 2, y: rowTop + up });
    rowTop = node.y + down + ROW_GAP;
  }
  // Each column of the graph after the last, left-aligned, the widest of it setting the pace.
  const column = (ids: string[], after: number) => {
    const w = Math.max(...ids.map((id) => nodes[id]!.w));
    for (const id of ids) nodes[id]!.x = after + nodes[id]!.w / 2;
    return after + w;
  };
  // Placed by where edges arrive: a file's name line, or the middle of anything else.
  const at = (id: string, y: number) => (nodes[id]!.y += y - entryY(nodes[id]!));
  const leafRight = Math.max(...leaves.map((id) => nodes[id]!.x + nodes[id]!.w / 2));
  const graphLeft = leafRight + (inline ? 0 : usesWidth + 30) + LANES + FRAME_INSET;
  graphEdge = graphLeft - 12 - FRAME_INSET;
  const apis = column(['AuthClient', 'OrdersApi', 'AnalyticsApi'], graphLeft);
  const mids = column(['HttpClient', 'Logger'], apis + COLUMN_GAP);
  column(['Config'], mids + COLUMN_GAP);
  // On the row of whoever asks for it; the rest between, logger level with analytics' lower port.
  at('AuthClient', exitY('UserMenu>AuthClient'));
  at('OrdersApi', exitY('OrdersTable>OrdersApi'));
  at('AnalyticsApi', exitY('RevenueChart>AnalyticsApi'));
  at('HttpClient', entryY(nodes.Dashboard!));
  at(
    'Logger',
    inline ? exitY('AnalyticsApi>Logger') : nodes.AnalyticsApi!.y + nodes.AnalyticsApi!.h / 2 - 6,
  );
  at('Config', (exitY('HttpClient>Config') + exitY('Logger>Config')) / 2);
  // Then the whole graph to the middle of the frame, which runs from the root's first line to the
  // bottom of the tree (without a root, the tree's top).
  const graph = Object.values(nodes).filter((n) => n.service);
  const frameTop = rootNode
    ? rootNode.y - (rootNode.h - 12) / 2 + LINE / 2 - 24
    : nodes.App!.y - COMPONENT_H / 2;
  const frameBottom =
    nodes.RevenueChart!.y + (callOf(uses ?? '') ? CALL_H / 2 + 12 : nodes.RevenueChart!.h / 2);
  const graphTop = Math.min(...graph.map((n) => n.y - n.h / 2));
  const graphBottom = Math.max(...graph.map((n) => n.y + n.h / 2));
  const shift = Math.min(0, (frameTop + frameBottom) / 2 - (graphTop + graphBottom) / 2);
  for (const node of graph) node.y += shift;
}
// Beside: one frame round the root and the graph it has to follow. Injector: round every
// service, built or not, so the frame stays put as it fills.
const framed: (typeof nodes)[string][] = injector
  ? Object.values(nodes).filter((n) => n.service)
  : beside && root
    ? Object.entries(nodes)
        .filter(([id, n]) => (n.service || id === 'Root') && marks[id] !== 'hidden')
        .map(([, n]) => n)
    : [];
const frame = framed.length
  ? {
      x: Math.min(...framed.map((n) => n.x - n.w / 2)) - 12 - (injector ? FRAME_INSET : 0),
      y: Math.min(...framed.map((n) => n.y - n.h / 2)) - 12,
      x2: Math.max(...framed.map((n) => n.x + n.w / 2)) + 12,
      y2: Math.max(...framed.map((n) => n.y + n.h / 2)) + 12,
    }
  : undefined;
/** Where the root's first line sits: in the injector layout, the line that creates it. */
const rootLineY = nodes.Root ? nodes.Root.y - (nodes.Root.h - 12) / 2 + LINE / 2 : 0;
// Build: as much room under the graph as over it, between it and the code.
if (build && frame) {
  const graphTop = Math.min(
    ...Object.values(nodes)
      .filter((n) => n.service)
      .map((n) => n.y - n.h / 2),
  );
  frame.y2 += graphTop - (nodes.Root!.y + nodes.Root!.h / 2) - 12;
}
// Injector: up past the root's first line too, so the arrow from it runs straight in.
if (injector && frame && nodes.Root) {
  frame.y = Math.min(frame.y, rootLineY - 24);
  frame.y2 = Math.max(frame.y2, nodes.RevenueChart!.y + CALL_H / 2 + 12);
}

const line = (key: string) => {
  const [a, b] = key.split('>');
  const from = nodes[a!]!;
  const to = nodes[b!]!;
  if ((sideways && 'service' in from && from.service) || outline) {
    return { x1: from.x + from.w / 2, y1: from.y, x2: to.x - to.w / 2 - 4, y2: to.y };
  }
  return { x1: from.x, y1: from.y + from.h / 2, x2: to.x, y2: to.y - to.h / 2 - 4 };
};
const mid = (key: string) => {
  const l = line(key);
  return { x: (l.x1 + l.x2) / 2, y: (l.y1 + l.y2) / 2 };
};

/**
 * Service→service edges (below layout) run as vertical and horizontal segments with rounded
 * corners: down from the source, along a channel just above the target, then into it. Edges into
 * the same target share that last drop. Each edge is labelled where it leaves its source, so the
 * same import or inject() shows once per file that makes it.
 */
type Pt = [number, number];
const RADIUS = 8;
/** Straight run before every arrowhead, so a tip never sits on a corner. */
const TIP_RUN = 14;
/** How far before a target its incoming edges turn in: a corner, the straight run, the gap. */
const TRUNK = RADIUS + TIP_RUN + 4;
const rounded = (pts: Pt[]) => {
  let d = `M ${pts[0]![0]} ${pts[0]![1]}`;
  for (let i = 1; i < pts.length - 1; i++) {
    const [px, py] = pts[i - 1]!;
    const [cx, cy] = pts[i]!;
    const [nx, ny] = pts[i + 1]!;
    const r = Math.min(RADIUS, Math.hypot(cx - px, cy - py) / 2, Math.hypot(nx - cx, ny - cy) / 2);
    const a = [cx - Math.sign(cx - px) * r, cy - Math.sign(cy - py) * r];
