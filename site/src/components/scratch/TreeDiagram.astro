---
/**
 * Lo-fi diagram for the Why scratch page: a component tree on top, the services the leaves use
 * below. Each beat passes marks, edge labels and notes to tell its part of the story.
 */
type Mark = 'hot' | 'pass' | 'fake' | 'ghost' | 'root';
interface Props {
  marks?: Record<string, Mark>;
  /** Edges drawn heavier, keyed `from>to`. */
  hot?: string[];
  /** Text on an edge, keyed `from>to`. */
  edgeLabels?: Record<string, string>;
  /** Text beside a node. */
  notes?: Record<string, string>;
  /** Label for component→service edges, e.g. `import` or `inject()`. */
  uses?: string;
}
const { marks = {}, hot = [], edgeLabels = {}, notes = {}, uses } = Astro.props;

const W = 130;
const H = 30;
const nodes: Record<string, { x: number; y: number; text: string; service?: boolean }> = {
  App: { x: 330, y: 30, text: '<App>' },
  Header: { x: 150, y: 100, text: '<Header>' },
  Dashboard: { x: 430, y: 100, text: '<Dashboard>' },
  UserMenu: { x: 150, y: 170, text: '<UserMenu>' },
  OrdersTable: { x: 340, y: 170, text: '<OrdersTable>' },
  RevenueChart: { x: 520, y: 170, text: '<RevenueChart>' },
  AuthClient: { x: 150, y: 270, text: 'auth client', service: true },
  OrdersApi: { x: 340, y: 270, text: 'orders api', service: true },
  AnalyticsApi: { x: 520, y: 270, text: 'analytics api', service: true },
  HttpClient: { x: 250, y: 345, text: 'http client', service: true },
  Logger: { x: 520, y: 345, text: 'logger', service: true },
  Config: { x: 380, y: 420, text: 'config', service: true },
};
const renders = [
  'App>Header',
  'App>Dashboard',
  'Header>UserMenu',
  'Dashboard>OrdersTable',
  'Dashboard>RevenueChart',
];
const usesEdges = ['UserMenu>AuthClient', 'OrdersTable>OrdersApi', 'RevenueChart>AnalyticsApi'];
const needs = [
  'AuthClient>HttpClient',
  'OrdersApi>HttpClient',
  'AnalyticsApi>HttpClient',
  'AnalyticsApi>Logger',
  'HttpClient>Config',
  'Logger>Config',
];

const line = (key: string) => {
  const [a, b] = key.split('>');
  const from = nodes[a!]!;
  const to = nodes[b!]!;
  return { x1: from.x, y1: from.y + H / 2, x2: to.x, y2: to.y - H / 2 - 4 };
};
const mid = (key: string) => {
  const l = line(key);
  return { x: (l.x1 + l.x2) / 2 + 6, y: (l.y1 + l.y2) / 2 };
};
const edges = [
  ...renders.map((key) => ({ key, kind: 'renders' })),
  ...usesEdges.map((key) => ({ key, kind: 'uses' })),
  ...needs.map((key) => ({ key, kind: 'needs' })),
];
const uid = Math.random().toString(36).slice(2, 8);
---

<svg class="tree" viewBox="0 0 680 450" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <marker
      id={`tip-${uid}`}
      viewBox="0 0 8 8"
      refX="4"
      refY="4"
      markerWidth="8"
      markerHeight="8"
      markerUnits="userSpaceOnUse"
      orient="auto"
    >
      <path d="M0,0 L8,4 L0,8 z" fill="context-stroke" />
    </marker>
  </defs>

  <line class="divider" x1="10" y1="222" x2="670" y2="222" />
  <text class="zone" x="10" y="214">
    components
  </text>
  <text class="zone" x="10" y="238">
    services
  </text>

  {edges.map(({ key, kind }) => (
    <line
      class:list={['edge', kind, { hot: hot.includes(key) }]}
      {...line(key)}
      marker-end={`url(#tip-${uid})`}
    />
  ))}
  {uses &&
    usesEdges.map((key) => (
      <text class="edge-label" {...mid(key)}>
        {uses}
      </text>
    ))}
  {Object.entries(edgeLabels).map(([key, text]) => (
    <text class="edge-label strong" {...mid(key)}>
      {text}
    </text>
  ))}

  {Object.entries(nodes).map(([id, node]) => (
    <g class:list={['node', { service: node.service }]} data-mark={marks[id]}>
      <rect x={node.x - W / 2} y={node.y - H / 2} width={W} height={H} rx={node.service ? 15 : 3} />
      <text x={node.x} y={node.y}>
        {node.text}
      </text>
    </g>
  ))}
  {Object.entries(notes).map(([id, text]) => {
    const node = nodes[id]!;
    const right = node.x < 500;
    return (
      <text
        class="note"
        x={right ? node.x + W / 2 + 8 : node.x - W / 2 - 8}
        y={node.y}
        text-anchor={right ? 'start' : 'end'}
      >
        {text}
      </text>
    );
  })}
</svg>

<style>
  .tree {
    display: block;
    width: 100%;
    max-width: 680px;
    height: auto;
    font-family: ui-monospace, monospace;
    font-size: 12px;
  }
  .divider {
    stroke: #ccc;
    stroke-dasharray: 2 4;
  }
  .zone {
    fill: #999;
    font-size: 11px;
  }
  .edge {
    stroke: #999;
    stroke-width: 1.5;
  }
  .edge.uses {
    stroke-dasharray: 5 3;
  }
  .edge.hot {
    stroke: #d33;
    stroke-width: 3;
  }
  .edge-label {
    fill: #777;
    font-size: 11px;
    dominant-baseline: central;
  }
  .edge-label.strong {
    fill: #c60;
  }
  .node rect {
    fill: #f2f2f2;
    stroke: #999;
  }
  .node text {
    text-anchor: middle;
    dominant-baseline: central;
    fill: #222;
  }
  [data-mark='hot'] rect {
    fill: #fdd;
    stroke: #d33;
    stroke-width: 2;
  }
  [data-mark='pass'] rect {
    fill: #fff1dd;
    stroke: #c60;
    stroke-width: 2;
  }
  [data-mark='root'] rect {
    fill: #222;
  }
  [data-mark='root'] text {
    fill: #fff;
  }
  [data-mark='fake'] rect {
    fill: #dde6ff;
    stroke: #35c;
    stroke-width: 2;
  }
  [data-mark='ghost'] rect {
    fill: none;
    stroke-dasharray: 4 3;
  }
  [data-mark='ghost'] text {
    fill: #aaa;
  }
  .note {
    fill: #c33;
    font-size: 11px;
    dominant-baseline: central;
  }
</style>
