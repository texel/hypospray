  // Injector, a leaf asking for a service: across under its label, along its lane, and in.
  if (outline && 'service' in to && to.service && !from.service) {
    const lane = laneX(a!, graphEdge);
    return [
      [from.x + from.w / 2, exitY(key)],
      [lane, exitY(key)],
      [lane, entryY(to)],
      [to.x - to.w / 2 - 4, entryY(to)],
