---
/**
 * Page shell for the Why scratch page (`pages/scratch/why.mdx`): the colour key and service legend
 * up top, then the page's Markdown. Styles are global because they style that Markdown.
 */
import Dep from './Dep.astro';
import { type Dep as DepName, deps } from './deps';

interface Props {
  frontmatter: { title: string };
}
const { title } = Astro.props.frontmatter;
const names = Object.keys(deps) as DepName[];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Why scratch</title>
  </head>
  <body>
    <main class="why">
      <p class="tag">scratch · why</p>
      <h1>{title}</h1>
      <p class="key">
        <span class="swatch purple"></span> hard-wired
        <span class="swatch orange"></span> carried by hand
        <span class="swatch blue"></span> Hypospray <span class="swatch red"></span> missing{' '}
        <span class="swatch green"></span> just added · solid is where a flow starts, soft is what
        it reaches
      </p>
      <p class="key">
        {names.map((name) => (
          <span class="legend">
            <Dep name={name} /> {deps[name].name}
          </span>
        ))}
      </p>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  /* What the site's code blocks (Expressive Code) expect from the landing page's tokens. */
  :root {
    --panel: #120e0a;
    --frame: #555;
    --bg: #fff;
    --font-code: ui-monospace, monospace;
    --font-display: system-ui, sans-serif;
  }
  body {
    margin: 0;
    background: #fff;
    color: #222;
    font:
      17px/1.5 system-ui,
      sans-serif;
  }
  .why {
    max-width: 720px;
    margin: 0 auto;
    padding: 32px 16px 96px;
  }
  .why .tag {
    color: #999;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .why h1 {
    font-size: 28px;
    line-height: 1.2;
  }
  .why h2 {
    margin-top: 72px;
    font-size: 20px;
  }
  .why h3 {
    margin: 32px 0 4px;
    font-size: 16px;
  }
  .why :not(pre) > code {
    font-family: ui-monospace, monospace;
    font-size: 0.85em;
  }
  .why .expressive-code {
    margin: 16px 0;
  }
  .why .key {
    color: #666;
    font-size: 14px;
  }
  .why .legend {
    margin-right: 14px;
    white-space: nowrap;
  }
  .why .swatch {
    display: inline-block;
    width: 12px;
    height: 12px;
    margin-left: 8px;
    vertical-align: -1px;
  }
  .why .swatch.purple {
    background: #84c;
  }
  .why .swatch.red {
    background: #d33;
  }
  .why .swatch.orange {
    background: #d70;
  }
  .why .swatch.blue {
    background: #36c;
  }
  .why .swatch.green {
    background: #1a9b4b;
  }
  /* Anchors: a faint link icon in the left margin of each heading and step. */
  .why h2,
  .why h3,
  .why [data-step] {
    position: relative;
  }
  .why h2,
  .why h3 {
    scroll-margin-top: 16px;
  }
  .why .anchor {
    position: absolute;
    top: 0.2em;
    right: 100%;
    margin-right: 8px;
    color: #bbb;
    line-height: 0;
    opacity: 0;
  }
  .why [data-step] > .anchor {
    top: 4px;
    margin-right: 10px;
    opacity: 0.6;
  }
  .why h2:hover > .anchor,
  .why h3:hover > .anchor,
  .why [data-step]:hover > .anchor,
  .why .anchor:focus {
    opacity: 1;
  }
  .why .anchor:hover {
    color: #36c;
  }
  .why .anchor svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .why .aside {
    color: #666;
    font-size: 15px;
  }
  .why .variant {
    margin-top: 40px;
    padding-top: 8px;
    border-top: 1px dashed #ccc;
  }
  .why .questions {
    margin-top: 72px;
    padding: 4px 20px;
    background: #fffbe6;
  }
</style>

<script>
  /*
   * Anchors for every heading and step, so the page can be linked into (and, later, get a table of
   * contents). h2s keep the ids Astro gives them; h3s and steps are named under their section,
   * since the same case names (and step numbers) come up in more than one.
   */
  const slug = (text: string) =>
    text
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '');
  // A chain link, drawn on a 24×24 grid.
  const icon =
    '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>';
  const link = (id: string, label: string) => {
    const a = document.createElement('a');
    a.href = `#${id}`;
    a.className = 'anchor';
    a.ariaLabel = label;
    a.innerHTML = icon;
    return a;
  };
  let section = '';
  const stepsBySection = new Map<string, HTMLElement[]>();
  for (const el of document.querySelectorAll<HTMLElement>('.why h2, .why h3, .why [data-step]')) {
    if (el.tagName === 'H2') section = el.id;
    else if (el.tagName === 'H3') el.id = `${section}--${slug(el.textContent ?? '')}`;
    else {
      stepsBySection.set(section, [...(stepsBySection.get(section) ?? []), el]);
      continue;
    }
    el.prepend(link(el.id, `Link to ${el.textContent?.trim()}`));
  }
  for (const [name, steps] of stepsBySection) {
    steps.forEach((step, i) => {
      step.id = `${name}--step-${i + 1}`;
      step.prepend(link(step.id, `Link to step ${i + 1} of ${steps.length}`));
    });
  }
  // The browser looked for the hash before these ids existed: look again.
  if (location.hash) {
    document.getElementById(decodeURIComponent(location.hash.slice(1)))?.scrollIntoView();
  }
</script>
