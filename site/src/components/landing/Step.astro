---
interface Props {
  number: number;
}
const { number } = Astro.props;
---

<li class="step">
  <div class="copy">
    <h3>
      <span class="num">{number}</span> <slot name="title" />
    </h3>
    <slot />
  </div>
  <slot name="code" />
</li>

<style>
  .step {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 32px;
    align-items: start;
  }

  .copy {
    min-width: 0;
    max-width: 38ch;
  }

  .num {
    display: inline-block;
    min-width: 0.6em;
    color: var(--text-muted);
  }

  h3 {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--hue);
  }

  .copy :global(p) {
    margin: 0;
    font-size: 18px;
    line-height: 1.5;
  }

  .copy :global(code) {
    font-family: var(--font-code);
    font-size: 0.85em;
    color: var(--docs);
  }

  @media (width < 1050px) {
    .step {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
