---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  hue?: string;
}
const { href, variant = 'primary', hue = 'var(--frame)' } = Astro.props;
---

<a class:list={['btn', variant]} href={href} style={`--hue: ${hue}`}>
  <slot />
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    height: 48px;
    padding: 0 28px;
    background: var(--hue);
    color: var(--bg);
    font-family: var(--font-display);
    font-size: 20px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color var(--motion);
  }

  .primary {
    border-radius: 24px;
  }

  @media (hover: hover) {
    .btn:hover {
      background: color-mix(in oklab, var(--hue), var(--text) 15%);
    }
  }

  .btn:active {
    background: color-mix(in oklab, var(--hue), var(--text) 25%);
  }

  .btn:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none;
    }
  }
</style>
