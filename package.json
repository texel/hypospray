{
  "name": "hypospray-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "site:dev": "pnpm --filter hypospray-site dev",
    "site:preview": "pnpm --filter hypospray-site preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:css": "stylelint \"**/*.{css,astro}\" && node site/scripts/check-global-styles.mjs",
    "lint:css:fix": "stylelint \"**/*.{css,astro}\" --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:regression": "vitest run --tagsFilter regression",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r exec rm -rf dist *.tsbuildinfo",
    "check": "pnpm run format:check && pnpm run lint && pnpm run lint:css && pnpm run typecheck && pnpm run test",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "^0.4.0",
    "@changesets/cli": "^3.0.1",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss-html": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-html": "catalog:",
    "stylelint-config-standard": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0"
}
