{
  "name": "@hypospray/core",
  "version": "0.0.1",
  "description": "Core dependency injection container for hypospray.",
  "keywords": [
    "container",
    "dependency-injection",
    "di",
    "esm",
    "injector",
    "inversion-of-control",
    "ioc",
    "typescript"
  ],
  "homepage": "https://github.com/texel/hypospray#readme",
  "bugs": "https://github.com/texel/hypospray/issues",
  "license": "MIT",
  "author": "Leigh Caplan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/texel/hypospray.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.ts",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.node.js",
  "types": "./dist/index.node.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/index.node.d.ts",
        "default": "./dist/index.node.js"
      },
      "browser": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:types",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
