// Project settings for hypospray.
//
// Requires the "Oxc" extension (id: oxc) — open `zed: extensions`, search Oxc,
// install. It provides the `oxlint` and `oxfmt` language servers referenced
// below; without it these keys do nothing.
{
  "lsp": {
    "oxlint": {
      // Pin the editor to the same oxlint the repo does. Comment this out to
      // use the version the extension manages instead.
      "binary": {
        "path": "node_modules/.bin/oxlint",
        "arguments": ["--lsp"]
      },
      "initialization_options": {
        "settings": {
          // null = discover .oxlintrc.json from the workspace root.
          "configPath": null,
          "run": "onType",
          "disableNestedConfig": false,
          "fixKind": "safe_fix",
          // Flags oxlint-disable comments that no longer suppress anything.
          "unusedDisableDirectives": "deny"
        }
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmt.configPath": null,
          "run": "onSave"
        }
      }
    }
  },

  // oxfmt owns formatting for everything it handles, and Zed's bundled
  // prettier is disabled per-language so the two can't fight. Without this,
  // saves drift away from .oxfmtrc.json (single quotes, import sorting).
  "languages": {
    "TypeScript": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "TSX": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "JavaScript": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "JSX": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "JSON": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "JSONC": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "Markdown": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "YAML": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    }
  }
}
